@using Hospital.Reports.Model

@{
    PdfDataReports _Model = Model;
}

<table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;font-family:'Times New Roman';font-size:14px;page-break-inside: avoid;font-family:'Cairo Regular'">
    <!-- ================= HEADER ================= -->
    <tr>
        <td colspan="3">
            <table width="100%" style="font-family:'Cairo Black';font-size:20px;">
                <tr>
                    <td width="40%" align="center">
                        Al-Azhar<br/> Urology Department
                    </td>

                    <td width="20%" align="center">
                        <table width="90" height="90">
                            <tr>
                                <td align="center" valign="middle" style="font-size:48px;">
                                    <img src="@_Model.ImageSrc" style="height:100px;width:100px;margin-left:20px" />
                                </td>
                            </tr>
                        </table>
                    </td>

                    <td width="40%" align="center" style="font-weight:700">
                        Patients' Database<br/> Intervention Report
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= ROW 1 ================= -->
    <tr>
        <td width="40%" style="padding-right:10px; padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td style="padding-left:5px;">@_Model.GetDataFieldValue("NationalId")</td>
                </tr>
            </table>
        </td>
        <td width="10%" style="padding-right:10px; padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td style="padding-left:5px;">@_Model.GetDataFieldValue("Age")</td>
                </tr>
            </table>
        </td>
        <td width="40%" style="padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("Name"))>@_Model.GetDataFieldValue("Name")</td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= ROW 2 ================= -->
    <tr>
        <td style="padding-right:10px; padding-bottom:5px;" width="40">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td style="padding-left:5px;">@_Model.GetDataFieldValue("HospitalFileNumber")</td>
                </tr>
            </table>
        </td>
        <td style="padding-right:10px; padding-bottom:5px;" width="15%">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td style="padding-left:5px;">@_Model.GetDataFieldValue("AdmissionDate")</td>
                </tr>
            </table>
        </td>
        <td style="padding-bottom:5px;" width="40%">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td style="padding-left:5px;">@_Model.GetDataFieldValue("InternalNumber")</td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= C/O ================= -->
    <tr>
        <td colspan="3" style="padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("ChiefComplaint"))>@_Model.GetDataFieldValue("ChiefComplaint")</td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= DURATION ================= -->
    <tr>
        <td colspan="3" style="text-align:center;">
            <table style="border:1px solid; height:35px; width:255px; display:inline-block;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("Duration")) align="left">
                        @_Model.GetDataFieldValue("Duration")
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= PROVISIONAL ================= -->
    <tr>
        <td colspan="3" style="padding-bottom:5px;">
            <table width="100%" style="border:1px solid; background:#F5DEB3;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("ProvisionalDiagnosis"))>
                        @_Model.GetDataFieldValue("ProvisionalDiagnosis")
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= ROW 3 ================= -->
    <tr>
        <td style="padding-right:10px; padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td style="padding-left:5px;">@_Model.GetDataFieldValue("InterventionDate")</td>
                </tr>
            </table>
        </td>
        <td style="padding-right:10px; padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("Theater"))>@_Model.GetDataFieldValue("Theater")</td>
                </tr>
            </table>
        </td>
        <td style="padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("MainSurgeon"))>@_Model.GetDataFieldValue("MainSurgeon")</td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= ASSISTANTS ================= -->
    <tr>
        <td colspan="3" style="padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("Assistants"))>@_Model.GetDataFieldValue("Assistants")</td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= ROW 4 ================= -->
    <tr>
        <td style="padding-right:10px; padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("Resident"))>@_Model.GetDataFieldValue("Resident")</td>
                </tr>
            </table>
        </td>
        <td style="padding-right:10px; padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("OtherSurgeons"))>@_Model.GetDataFieldValue("OtherSurgeons")</td>
                </tr>
            </table>
        </td>
        <td style="padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("OffFieldSupervisor"))>@_Model.GetDataFieldValue("OffFieldSupervisor")</td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= ANAESTHESIA ================= -->
    <tr>
        <td colspan="3" style="text-align:center;">
            <table style="border:1px solid; height:35px; width:255px; display:inline-block;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("Anesthesia")) align="left">
                        @_Model.GetDataFieldValue("Anesthesia")
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= INTERVENTION ================= -->
    <tr>
        <td colspan="3" style="padding-bottom:5px;">
            <table width="100%" style="border:1px solid; background:#F5DEB3;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("Intervention"))>@_Model.GetDataFieldValue("Intervention")</td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= DETAILS ================= -->
    <tr>
        <td colspan="3" style="padding-bottom:5px;">
            <table width="100%" style="border:1px solid;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("InterventionDetails")) height="205" valign="top">
                        @_Model.GetDataFieldValue("InterventionDetails")
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= TUBES ================= -->
    <tr>
        <td colspan="3" style="padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("TubesFixed"))>@_Model.GetDataFieldValue("TubesFixed")</td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= ROW 5 ================= -->
    <tr>
        <td style="padding-right:10px; padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("Category"))>@_Model.GetDataFieldValue("Category")</td>
                </tr>
            </table>
        </td>
        <td style="padding-right:10px; padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("Approach"))>@_Model.GetDataFieldValue("Approach")</td>
                </tr>
            </table>
        </td>
        <td style="padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("Organ"))>@_Model.GetDataFieldValue("Organ")</td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= INTRA OP ================= -->
    <tr>
        <td colspan="3" style="padding-bottom:5px;">
            <table width="100%" style="border:1px solid;height:35px;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("IntraOperativeCourse"))>@_Model.GetDataFieldValue("IntraOperativeCourse")</td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td colspan="3" style="padding-bottom:5px;">
            <table width="100%" style="border:1px solid;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("PostOpAdverseEvents")) height="85" valign="top">
                        @_Model.GetDataFieldValue("PostOpAdverseEvents")
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <!-- ================= BLOOD ================= -->
    <tr>
        <td colspan="3" style="text-align:center;">
            <table style="border:1px solid; height:35px; width:255px; display:inline-block;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("BloodTransfusionUnits")) align="left">
                        @_Model.GetDataFieldValue("BloodTransfusionUnits")
                    </td>
                </tr>
            </table>
        </td>
        <!-- ================= POST OP ================= -->
    <tr>
        <td colspan="3">
            <table width="100%" style="border:1px solid; background:#F5DEB3;">
                <tr>
                    <td @_Model.GetTdDirectionStyle(@_Model.GetDataFieldValue("PostOpRecommendations")) height="105" valign="top">
                            @_Model.GetDataFieldValue("PostOpRecommendations")
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>